# PortSentinel Backend Environment Variables

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./portsentinel.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Operational Modes (Phase 1 Foundation)
DEMO_MODE=True
SIMULATED_FIREWALL=True

